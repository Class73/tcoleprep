	{
	  id: "TCOLE_case_q72",
	  subject: "Case Law",
	  points: 1,
	  prompt: "During an arrest, an officer handcuffs a suspect too tightly and does not double-lock the handcuffs. The suspect complains repeatedly and tells the officer the cuffs are aggravating a medical condition. According to IRG Ch. 31, what may result?",
	  options: [
